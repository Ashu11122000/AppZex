{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,

    "types": ["node"],

    "sourceMap": true,
    "declaration": true
  },

  "include": ["src/**/*.ts", "prisma7.config.ts", "prisma/**/*.ts"],

  "exclude": ["node_modules", "dist", "generated"]
}
